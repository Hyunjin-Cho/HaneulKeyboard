# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Python cache (audit/build scripts)
__pycache__/
*.pyc

# Personal
.env
*.local
.claude/settings.local.json
.claude/settings.json

# Code signing — never commit private keys / certs
*.p12
*.key
*.cer
*.crt
*.pem
*.mobileprovision

# XcodeGen output (regenerated from project.yml)
*.xcodeproj
Generated/

# Local-only reference materials (fetched from open-source IMEs)
references/

# Internal dev notes — contain machine paths / cert info; keep local only, not for public repo
CLAUDE.md
WORKLOG.md
.claude/scheduled_tasks.lock
/HaneulKeyboard-설치.zip
/HaneulKeyboard_*.zip
/HaneulKeyboard_*.dmg
# 2026-11-12 (#228): 빌드 스크립트가 루트에 쓰는 해시 파일(.zip.sha256·.dmg.sha256)도 커밋하지 않는다.
/HaneulKeyboard_*.sha256
/.tools/
/HaneulKeyboard.app

# Internal review/verification artifacts — never publish
review-*.md
crucible/

# Video recordings (GIF source) — never commit
*.mov
*.mp4
# 2026-11-03 (#113): 안내 7 무대 영상은 앱 리소스다(승인 그림 — 원본·재현은 비공개 haneul-art). 이 파일만 예외.
!/Resources/Onboarding/OnboardingP7.mp4

# 2026-09-21 (#52): 로컬 검증용 무서명 빌드 산출물(.tmp/dd 등) — 커밋 금지
/.tmp/

# Internal review artifacts and session handoffs stay local.
/Review/
/docs/HANDOFF_*.md
/docs/handoff-*.md
/docs/feedback/
